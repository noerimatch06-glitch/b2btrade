datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model purchaseorder {
  id               Int      @id @default(autoincrement())
  poNumber         String
  sender           String
  poRecipient      String
  deliveryLocation String
  status           String
  paymentTerm      String
  poDate           String
  deliveryDate     String
  totalPpn         Float
  totalOrder       Float
  totalQty         Int
  totalDiscount    Float
  expiredDate      String
  createdAt        DateTime @default(now())
}
model User {
  id        Int      @id @default(autoincrement())

  username  String   @unique
  password  String

  role      String

  createdAt DateTime @default(now())
}
